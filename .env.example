# Строка подключения к Postgres (Neon / Vercel Postgres / Supabase — любой вариант подойдёт)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Длинный случайный токен, который вы сами придумываете.
# Тот же токен нужно будет указать в настройках решения в личном кабинете разработчика МойСклад —
# МойСклад будет присылать его в заголовке Lognex-Discount-API-Auth-Token с каждым запросом.
# Сгенерировать можно, например, командой: openssl rand -hex 32
MS_LOYALTY_AUTH_TOKEN="сгенерируйте_длинный_случайный_токен"

# --- Облегчённая версия без LoyaltyAPI (обычный JSON API + вебхуки) ---

# Токен доступа обычного аккаунта МойСклад: Настройки → API.
# Не требует регистрации разработчика.
MS_API_TOKEN="токен_из_настроек_вашего_аккаунта_мойсклад"

# Секрет для проверки входящих вебхуков от МойСклад (передаётся в URL как ?secret=...,
# т.к. вебхуки МойСклад не поддерживают собственные заголовки авторизации).
MS_WEBHOOK_SECRET="сгенерируйте_ещё_один_длинный_случайный_токен"
